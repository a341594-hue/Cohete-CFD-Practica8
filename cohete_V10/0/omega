/* OpenFOAM 12 - Disipacion especifica turbulenta del cohete */

FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}

dimensions [0 0 -1 0 0 0 0];

internalField uniform 133.8;

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform 133.8;
    }

    outlet
    {
        type inletOutlet;
        inletValue uniform 133.8;
        value uniform 133.8;
    }

    farField
    {
        type zeroGradient;
    }

    cohete
    {
        type omegaWallFunction;
        value uniform 133.8;
    }
}
