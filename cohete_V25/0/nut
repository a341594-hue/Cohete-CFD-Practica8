/* OpenFOAM 12 - Viscosidad turbulenta del cohete */

FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}

dimensions [0 2 -1 0 0 0 0];

internalField uniform 0;

boundaryField
{
    inlet
    {
        type calculated;
        value uniform 0;
    }

    outlet
    {
        type calculated;
        value uniform 0;
    }

    farField
    {
        type calculated;
        value uniform 0;
    }

    cohete
    {
        type nutkWallFunction;
        value uniform 0;
    }
}
