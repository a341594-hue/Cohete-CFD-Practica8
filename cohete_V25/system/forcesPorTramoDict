FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object forcesPorTramoDict;
}

fuerzasPorTramo
{
    type forces;
    libs ("libforces.so");

    patches (cohete);
    rho rhoInf;
    rhoInf 1.225;
    CofR (-0.2915325 0 0);

    log true;

    binData
    {
        nBin 20;
        direction (1 0 0);
        cumulative false;
    }

    writeControl timeStep;
    writeInterval 1;
}
