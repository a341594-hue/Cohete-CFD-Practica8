
/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM 12 - Laboratorio de Aerofluidos
| Mallado inicial del cohete
\*---------------------------------------------------------------------------*/

FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

// Etapas de mallado
castellatedMesh true;
snap            true;
addLayers       true;

// Geometria del cohete y zona de refinamiento
geometry
{
    cohete
    {
        type triSurfaceMesh;
        file "cohete_centrado.stl";
    }

    refinementBox
    {
        type searchableBox;
        min (-0.75 -0.15 -0.15);
        max ( 0.90  0.15  0.15);
    }
}

castellatedMeshControls
{
    // Limites iniciales para controlar memoria
    maxLocalCells       700000;
    maxGlobalCells      750000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    // Aristas caracteristicas del cohete
    features
    (
        {
            file "cohete_centrado.eMesh";
            level 5;
        }
    );

    // Refinamiento de la superficie
    refinementSurfaces
    {
        cohete
        {
            level (5 5);

            patchInfo
            {
                type wall;
                inGroups (coheteGroup);
            }
        }
    }

    resolveFeatureAngle 30;

    // Refinamiento alrededor del cohete y su estela cercana
    refinementRegions
    {
        refinementBox
        {
            mode inside;
            levels ((1E15 3));
        }
    }

    // Punto situado en la region de aire
    insidePoint (0.5 0.25 0.35);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;

    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

// Se conservan los parametros de capas,
// pero su generacion esta desactivada en esta prueba.
addLayersControls
{
    relativeSizes true;

    layers
    {
        "cohete.*"
        {
            nSurfaceLayers 3;
        }
    }

    expansionRatio 1.0;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;

    featureAngle 100;
    slipFeatureAngle 30;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;

    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

// Criterios de calidad del mallado
meshQualityControls
{
    #include "meshQualityDict"
}

writeFlags
(
    scalarLevels
);

mergeTolerance 1e-6;

// ************************************************************************* //
