FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         500;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //

functions
{
    forceCoeffsCohete
    {
        type            forceCoeffs;
        libs            ("libforces.so");

        patches         (cohete);
        log             true;

        rho             rhoInf;
        rhoInf          1.225;

        CofR            (-0.2915325 0 0);

        dragDir         (1 0 0);
        liftDir         (0 0 1);
        pitchAxis       (0 1 0);

        magUInf         20;
        lRef            0.583065;
        Aref            0.001790157;

        writeControl    timeStep;
        writeInterval   1;
    }
}
